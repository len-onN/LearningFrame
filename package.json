{
  "name": "learningframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm --prefix frontend test",
    "build": "npm --prefix frontend run build",
    "e2e": "node scripts/e2e/run-e2e.mjs",
    "e2e:up": "docker compose -p learningframe-e2e -f docker-compose.e2e.yml up -d --build --wait",
    "e2e:test": "npm --prefix frontend run e2e:test",
    "e2e:down": "docker compose -p learningframe-e2e -f docker-compose.e2e.yml down -v --remove-orphans"
  }
}
